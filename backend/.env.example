PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/shopsphere
# For MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/shopsphere?retryWrites=true&w=majority
JWT_SECRET=shopsphere_super_secret_jwt_key_2026_classify_store
JWT_EXPIRE=30d

# Email Notification Settings (Nodemailer)
# Use your Gmail address and 16-character App Password (from Google Account Security -> App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-digit-app-password
ADMIN_EMAIL=admin@shopsphere.com
# All contact / enquiry form notifications are sent to this address
ENQUIRY_EMAIL=admin@shopsphere.com

